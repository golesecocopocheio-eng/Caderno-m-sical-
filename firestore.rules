rules_version = '2';
// Regras do Firestore para o aplicativo do bar.
// Cole este texto no Console do Firebase: Firestore Database → Regras → Publicar.
//
// Quem é dono: quem criou o código do bar, ou quem foi liberado com o PIN do dono.
// A equipe (quem abre a Portaria pelo link ou QR Code) só consegue:
//   - ler os valores da entrada;
//   - lançar entradas e saídas em nome dela;
//   - ver e desfazer as entradas e saídas que ela mesma lançou.
// Faturamento, lançamentos do dia, Caixa, Estoque, Cardápio e histórico: só o dono.
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() { return request.auth != null; }
    function eu() { return request.auth.uid; }
    function dono(codigo) {
      return logado() && (
        get(/databases/$(database)/documents/bares/$(codigo)).data.dono == eu()
        || exists(/databases/$(database)/documents/bares/$(codigo)/donos/$(eu()))
        || (exists(/databases/$(database)/documents/bares/$(codigo)/acesso/donos)
            && eu() in get(/databases/$(database)/documents/bares/$(codigo)/acesso/donos).data.get('uids', []))
      );
    }
    function meuNovo() { return logado() && request.resource.data.u == eu(); }
    function meu() { return logado() && resource.data.u == eu(); }

    match /bares/{codigo} {
      // Quem sabe o código lê quem é o dono; o documento é criado uma vez e nunca alterado.
      allow get, create: if logado();

      // Nome de cada pessoa (aparece no histórico do dono).
      match /pessoas/{uid} {
        allow read: if logado();
        allow write: if logado() && uid == eu();
      }

      // PIN do dono (guardado como hash): só o dono lê e troca.
      match /acesso/{doc} {
        allow read, write: if dono(codigo);
      }

      // Celulares liberados como dono. Um celular se libera sozinho só se mandar o PIN certo.
      match /donos/{uid} {
        allow get: if logado() && uid == eu();
        allow read, delete: if dono(codigo);
        allow create: if logado() && uid == eu()
          && exists(/databases/$(database)/documents/bares/$(codigo)/acesso/donos)
          && request.resource.data.pin == get(/databases/$(database)/documents/bares/$(codigo)/acesso/donos).data.pin;
      }

      // Histórico de alterações: qualquer pessoa do bar registra, só o dono lê. Nunca é editado nem apagado.
      match /historico/{registro} {
        allow create: if logado();
        allow read: if dono(codigo);
      }

      // Portaria: valores da entrada (todos leem, só o dono muda).
      match /portaria_config/{doc} {
        allow read: if logado();
        allow write: if dono(codigo);
      }

      // Portaria: entradas e saídas. A equipe só vê, lança e desfaz as próprias.
      match /portaria_entradas/{doc} {
        allow read, delete: if dono(codigo) || meu();
        allow create: if dono(codigo) || meuNovo();
        allow update: if dono(codigo);
      }
      match /portaria_saidas/{doc} {
        allow read, delete: if dono(codigo) || meu();
        allow create: if dono(codigo) || meuNovo();
        allow update: if dono(codigo);
      }

      // Portaria: registro de lançadas e apagadas. A equipe registra, só o dono lê.
      match /portaria_log/{doc} {
        allow create: if dono(codigo) || meuNovo();
        allow read, update, delete: if dono(codigo);
      }

      // Todo o resto (Caixa, Estoque, Cardápio, Preços, Fotos…): só o dono.
      // O histórico fica de fora: nem o dono edita ou apaga registros dele.
      match /{colecao}/{document=**} {
        allow read, write: if colecao != 'historico' && dono(codigo);
      }
    }

    // Clã Speak (tradutor.html): sala com aprovação do dono.
    // Quem cria a sala vira o dono. Os outros pedem para entrar (membros/{uid} = pendente)
    // e só leem e escrevem falas e a lista de pessoas depois que o dono aprova.
    // Ninguém pode listar as salas.
    match /salas/{sala} {
      function donoSala() {
        return logado() && get(/databases/$(database)/documents/salas/$(sala)).data.dono == eu();
      }
      function aprovadoSala() {
        return logado() && (donoSala()
          || (exists(/databases/$(database)/documents/salas/$(sala)/membros/$(eu()))
              && get(/databases/$(database)/documents/salas/$(sala)/membros/$(eu())).data.status == 'aprovado'));
      }
      allow get: if logado();
      allow create: if logado() && request.resource.data.dono == eu();

      // Pedidos de entrada: cada um cria o próprio pedido (pendente); só o dono aprova, recusa ou remove.
      match /membros/{uid} {
        allow get: if logado() && (uid == eu() || donoSala());
        allow list: if donoSala();
        allow create: if logado() && uid == eu() && request.resource.data.status == 'pendente';
        allow update: if donoSala();
        allow delete: if donoSala() || (logado() && uid == eu());
      }

      match /falas/{doc} {
        allow read, create: if aprovadoSala();
      }
      match /pessoas/{doc} {
        allow read, write: if aprovadoSala();
      }
    }

    // Clã Speak: backup automático. Quem tem o código de 12 letras lê e atualiza o próprio
    // backup. Ninguém pode listar os códigos nem apagar backups.
    match /copias/{codigo} {
      allow get: if logado() && codigo.size() == 12;
      allow create, update: if logado() && codigo.size() == 12
        && request.resource.data.app == 'claspeak' && request.resource.data.dados is string;
    }
  }
}

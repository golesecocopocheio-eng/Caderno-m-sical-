rules_version = '2';
// Regras do Firestore para o aplicativo do bar.
// Cole este texto no Console do Firebase: Firestore Database → Regras → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {
    // O documento do bar guarda quem é o dono. Pode ser lido por quem sabe o código,
    // criado uma vez e nunca alterado pelo app. Ninguém pode listar os códigos.
    match /bares/{codigo} {
      allow get, create: if request.auth != null;

      // Dados do caixa, portaria, estoque e nomes da equipe.
      match /{colecao}/{document=**} {
        allow read, write: if request.auth != null;
      }
    }
  }
}

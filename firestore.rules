rules_version = '2';
// Regras do Firestore para o aplicativo do bar.
// Cole este texto no Console do Firebase: Firestore Database → Regras → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {
    // O documento do bar guarda quem é o dono. Pode ser lido por quem sabe o código,
    // criado uma vez e nunca alterado pelo app. Ninguém pode listar os códigos.
    match /bares/{codigo} {
      allow get, create: if request.auth != null;

      // Histórico de alterações: pode ser lido e ganhar registros novos,
      // mas nunca editado nem apagado.
      match /historico/{registro} {
        allow read, create: if request.auth != null;
      }

      // Dados do caixa, portaria, estoque e nomes da equipe.
      match /{colecao}/{document=**} {
        allow read, write: if request.auth != null && colecao != 'historico';
      }
    }

    // Tradutor ao Vivo (tradutor.html): quem sabe o código da sala lê e escreve as falas
    // e a lista de pessoas. Ninguém pode listar as salas.
    match /salas/{sala}/{colecao}/{doc} {
      allow read, write: if request.auth != null && colecao in ['falas', 'pessoas'];
    }

    // Clã Speak: backup automático. Quem tem o código de 12 letras lê e atualiza o próprio
    // backup. Ninguém pode listar os códigos nem apagar backups.
    match /copias/{codigo} {
      allow get: if request.auth != null && codigo.size() == 12;
      allow create, update: if request.auth != null && codigo.size() == 12
        && request.resource.data.app == 'claspeak' && request.resource.data.dados is string;
    }
  }
}
